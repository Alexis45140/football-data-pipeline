import os
import pandas as pd
from google.cloud import bigquery

# ÉTAPE 1 : Authentification
# On dit à Python où se trouve le "badge" pour entrer chez Google Cloud
os.environ["GOOGLE_APPLICATION_CREDENTIALS"] = r"C:\Users\alexi\Documents\Data_engenering\football-data-pipeline\credentials.json"

def upload_transfers_to_bq():
    # Initialisation du client BigQuery
    client = bigquery.Client()

    # ÉTAPE 2 : Configuration de la cible
    # REMPLACE PAR : ton_projet_id.ton_dataset.nom_de_table
    table_id = "my-project-foot-496012.football_data.stg_transferts"

    # ÉTAPE 3 : Chargement des données
    try:
        # On lit le CSV que tu as généré à l'étape précédente
        df = pd.read_csv("transferts_football.csv")
        
        # Nettoyage de sécurité pour les colonnes (BigQuery n'aime pas les espaces)
        df.columns = [c.replace(' ', '_') for c in df.columns]

        # Configuration du "Job" (le travail d'import)
        job_config = bigquery.LoadJobConfig(
            # On écrase la table si elle existe déjà (WRITE_TRUNCATE)
            # Pratique pour tester tes scripts plusieurs fois
            write_disposition="WRITE_TRUNCATE",
            autodetect=True, # Laisse BigQuery deviner les types (Date, Int, String)
        )

        print(f"⏳ Envoi de {len(df)} lignes vers BigQuery...")
        
        # Lancement de l'import
        job = client.load_table_from_dataframe(df, table_id, job_config=job_config)
        job.result()  # Attend que l'import soit terminé

        print(f"✅ Succès ! Tes données sont consultables ici : {table_id}")

    except FileNotFoundError:
        print("❌ Erreur : Le fichier 'transferts_football.csv' est introuvable.")
    except Exception as e:
        print(f"❌ Une erreur est survenue : {e}")

if __name__ == "__main__":
    upload_transfers_to_bq()