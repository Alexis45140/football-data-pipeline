import os
import requests
from dotenv import load_dotenv
import pandas as pd

load_dotenv()
headers = {
    "x-rapidapi-key": os.getenv("RAPIDAPI_KEY"),
    "x-rapidapi-host": "sportapi7.p.rapidapi.com"
}

# On demande la liste des saisons pour le tournoi 17
url = "https://sportapi7.p.rapidapi.com/api/v1/unique-tournament/17/seasons"

print("Récupération des saisons pour la Premier League...")
response = requests.get(url, headers=headers)

if response.status_code == 200:
    seasons = response.json().get('seasons', [])
    for s in seasons:
        print(f"Saison: {s.get('year')} | ID: {s.get('id')}")
else:
    print(f"Erreur {response.status_code} : {response.text}")