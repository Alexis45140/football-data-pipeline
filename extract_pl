import os
import requests
import pandas as pd
import time
from dotenv import load_dotenv

load_dotenv()

headers = {
    "x-rapidapi-key": os.getenv("RAPIDAPI_KEY"),
    "x-rapidapi-host": "sofascore.p.rapidapi.com"
}

# Les IDs des mastodontes de la PL (plus stables que les IDs de tournois)
# 35=Man Utd, 17=Arsenal, 42=Man City, 38=Liverpool, 33=Chelsea
top_clubs = [35, 17, 42, 38, 33]

def get_data_by_team():
    all_players = []
    
    for t_id in top_clubs:
        # On utilise l'endpoint par équipe, beaucoup plus robuste
        url = "https://sofascore.p.rapidapi.com/teams/get-player-statistics"
        params = {
            "teamId": str(t_id),
            "uniqueTournamentId": "17",
            "seasonId": "52486" # On tente 2026, si 204, on switchera à 52486
        }
        
        print(f"📡 Extraction du club ID: {t_id}...")
        response = requests.get(url, headers=headers, params=params)
        
        if response.status_code == 200:
            results = response.json().get('results', [])
            for item in results:
                player = item.get('player', {})
                stats = item.get('statistics', {})
                all_players.append({
                    "Joueur": player.get('name'),
                    "Equipe": item.get('team', {}).get('name'),
                    "Grosses_Occasions": stats.get('bigChancesCreated', 0),
                    "Note": item.get('rating', 0)
                })
        elif response.status_code == 204:
            print(f"⚠️ Pas de stats pour le club {t_id} sur cette saison.")
        
        time.sleep(1) # Sécurité pour le quota

    if all_players:
        df = pd.DataFrame(all_players)
        df_top = df.sort_values(by="Grosses_Occasions", ascending=False).head(50)
        df_top.to_csv("top_createurs_final.csv", index=False)
        print("\n✅ VICTOIRE ! Fichier 'top_createurs_final.csv' créé.")
        print(df_top.head(5))
    else:
        print("❌ Toujours rien. L'API SofaScore semble vide pour la saison 2026.")

if __name__ == "__main__":
    get_data_by_team()